# NextAuth
NEXTAUTH_SECRET=your-secret-key
NEXTAUTH_URL=http://localhost:3000

# API base URL (for client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client forwarding for the API's rate limits. Calls this server makes to the API (login, token refresh,
# the signup context) come from this server's address, so it names the real client to the API.
# Secret shared with the API, server-only (no NEXT_PUBLIC_ prefix, never sent to the browser): must equal
# the API's INTERNAL_API_SECRET (min 32 chars; shorter logs a warning at startup). Empty (default) =
# nothing is forwarded and the API limits those calls by this server's address.
INTERNAL_API_SECRET=
# Number of trusted reverse proxies in front of THIS server, used to read the client IP from
# X-Forwarded-For counting from the right. Default 0 = reached directly, where the client IP cannot be
# trusted, so nothing is forwarded. Set it to the real hop count; too high lets clients pick their IP.
WEB_TRUSTED_PROXY_COUNT=0

# Sentry error tracking (INFRA-5). Public DSN used by the browser, server, and edge runtimes.
# Leave empty to disable Sentry entirely (default); set it — even on localhost — to capture errors.
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are build-only and set in the deploy environment
# to upload source maps; without SENTRY_AUTH_TOKEN the build neither uploads nor needs them.
NEXT_PUBLIC_SENTRY_DSN=

# Fallback currencies shown in the sidebar switch when no settings saved yet.
# Both of them are used for the pinned currencies group in the currency combobox.
# If omitted, ARS is used as the primary currency and USD as the secondary currency.
NEXT_PUBLIC_FALLBACK_PRIMARY_CURRENCY=ARS
NEXT_PUBLIC_FALLBACK_SECONDARY_CURRENCY=USD

# Dollar rate preference fallback (oficial, mep, or blue). Used when the user hasn't set a preference.
# If omitted, MEP is used as the default dollar rate preference.
NEXT_PUBLIC_FALLBACK_DOLLAR_RATE=mep

# "Dólar tarjeta" multiplier over the OFICIAL rate (decimal). As of 2026 only the 30% Ganancias
# perception applies to foreign-currency card consumption — Impuesto PAIS expired 2024-12-23 — so
# 1.30 is current. Regulatory and volatile with no clean API, hence configurable rather than hardcoded.
# Used ONLY for the estimate shown next to a cross-currency card settlement's implied rate, as a
# sanity check against a typo: the amount you type is always what gets recorded, and no stored value
# depends on this. Defaults to 1.30 if omitted.
NEXT_PUBLIC_CARD_PERCEPTION_MULTIPLIER=1.30

# Preferred currencies shown in their own group in the currency combobox (comma-separated).
# If empty or omitted, no preferred group is shown.
NEXT_PUBLIC_PREFERRED_CURRENCIES=BRL,EUR,GBP

# Dashboard period presets (up to 4). "All" is always appended as the last option.
# Format: NM = N months (e.g. 1M, 3M, 6M), NY = N years (e.g. 1Y, 2Y), YTD = year to date.
# Note: YTD = Jan 1 of current year → today. 1Y = 12 months back → today. They differ.
# Optional override: with none set, the code offers 1M, 3M, 6M and YTD (the values below); with any
# set, exactly the ones set are offered. A user's own presets in settings replace either.
NEXT_PUBLIC_PERIOD_PRESET_1=1M
NEXT_PUBLIC_PERIOD_PRESET_2=3M
NEXT_PUBLIC_PERIOD_PRESET_3=6M
NEXT_PUBLIC_PERIOD_PRESET_4=YTD

# Maximum collections per user (soft limit). Defaults to 50 if omitted.
NEXT_PUBLIC_MAX_COLLECTIONS=20

# Percentage of max collections at which the approaching-limit warning appears. If omitted, no warning.
NEXT_PUBLIC_COLLECTION_LIMIT_WARNING_PCT=80

# Dashboard health-indicator thresholds. All four are used to colour the cards on `/dashboard`'s
# footer health row. The user can override each one in `Settings > Alerts & limits`; these env
# values are the deploy-time fallback shown as placeholders in the form.
#
# Liquidity ratio threshold (integer percent, 1-99). Above this percent of monthly income spoken
# for by fixed commitments, the card turns amber; +10 pp further turns it red. Default 40.
NEXT_PUBLIC_LIQUIDITY_THRESHOLD_PCT=40

# Savings rate healthy threshold (integer percent, 1-99). Saving at least this percent of income
# turns the Savings Rate card green. Default 20.
NEXT_PUBLIC_SAVINGS_RATE_HEALTHY_PCT=20

# Savings rate moderate threshold (integer percent, 1-99). Between this and healthy renders amber;
# below renders red. Default 10.
NEXT_PUBLIC_SAVINGS_RATE_MODERATE_PCT=10

# Income / expense ratio healthy threshold (decimal, 0.1-10.0). At or above this value, the
# Income / Expense card turns green. Break-even (1.0) is hardcoded as the amber pivot — below 1
# is always red. Default 1.5.
NEXT_PUBLIC_INCOME_EXPENSE_RATIO_HEALTHY=1.5
