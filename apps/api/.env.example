# Database
# Request connections use a restricted role subject to Row-Level Security (SEC-15). It must NOT be
# the table owner/superuser or RLS is silently bypassed (the owner role is exempt from policies).
DATABASE_URL=postgresql+asyncpg://renly_app:pass@localhost:5432/renly
# Privileged connection (table owner) for context-less work: scheduler, migrations, and pre-auth
# lookups (login/register/API-key verify). Bypasses RLS. Falls back to DATABASE_URL when unset,
# but production must set a distinct owner role.
DATABASE_ADMIN_URL=postgresql+asyncpg://renly:pass@localhost:5432/renly

# JWT — must match the web app's NEXTAUTH_SECRET; minimum 32 characters (validated at startup).
JWT_SECRET=
JWT_ALGORITHM=HS256
# Access token lifetime in minutes. Kept short (AUTH-7): the web silently exchanges the refresh token
# for a new access token when it expires.
JWT_EXPIRE_MINUTES=30
# Refresh token lifetimes (AUTH-7). A "remember me" login gets the long window; an ordinary login the
# short one (kept tight so an unchecked login on a shared computer doesn't linger). Both slide on each
# rotation; when the refresh token itself expires, the user re-logs in.
REFRESH_TOKEN_REMEMBER_DAYS=30
REFRESH_TOKEN_DEFAULT_HOURS=2

# App
# Deployment environment: "development" (default) or "production". In production the API docs
# (/docs, /redoc, /openapi.json) are disabled and debug/tracebacks are off.
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins (e.g. https://app.renly.com,https://renly.com).
# Defaults to the local web app.
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies in front of the app, used to find the real client IP for rate
# limiting. 0 (default) = reached directly. Behind a proxy/LB set it to the hop count, or per-IP
# rate limits collapse onto the proxy's address. Too high lets clients spoof their rate-limit key.
TRUSTED_PROXY_COUNT=0
# Sentry error-tracking DSN (INFRA-5). Empty (default) = Sentry disabled, app sends nothing.
# Set it (even on localhost) to capture errors; the environment tag comes from ENVIRONMENT above.
SENTRY_DSN=
# Public base URL of the web app (no trailing slash). Used to build the links in account emails
# (verification, password reset, invite). Defaults to the local web app.
WEB_BASE_URL=http://localhost:3000
# Registration access mode: "invite" (default) requires a valid admin invite to register — the
# invite-only access gate; "open" lets anyone register. Only "invite" is used at launch.
SIGNUP_MODE=invite

# Email (transactional — SHELL-3)
# Provider selector: "console" (default) logs the message to the API logs for local dev; "resend"
# sends via the Resend API. Swappable behind the EmailService port.
EMAIL_PROVIDER=console
# Resend API key. Required when EMAIL_PROVIDER=resend (validated at startup); unused for console.
EMAIL_API_KEY=
# From address for outbound email (e.g. "Renly <noreply@yourdomain.com>"). Must be a verified
# Resend sender in production. Defaults to Resend's shared onboarding sender for early testing.
EMAIL_FROM=Renly <onboarding@resend.dev>

# Web push (shared money — the notification layer)
# base64url-encoded P-256 private key of a VAPID pair (RFC 8292). Empty (default) = this deployment
# sends no push notifications at all, and the app says so instead of offering a switch that does
# nothing. There is deliberately NO public-key setting: the applicationServerKey the browser
# subscribes with is derived from this one, so the pair can never be mismatched.
# Generate one with:
#   uv run python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;\
# print(base64.urlsafe_b64encode(ec.generate_private_key(ec.SECP256R1()).private_numbers()\
# .private_value.to_bytes(32,'big')).rstrip(b'=').decode())"
VAPID_PRIVATE_KEY=
# Contact the push service can reach about this deployment: a "mailto:" address or an https URL.
# Defaults to WEB_BASE_URL, which is a valid subject and cannot go stale like a hard-coded address.
VAPID_SUBJECT=
